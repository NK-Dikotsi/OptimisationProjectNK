<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <property name="LOG_FILE" value="runs"/>
  <property name="LOG_PATTERN" value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

  <!-- Console appender for immediate feedback -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- JSON file appender for structured events (events.jsonl) -->
  <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}/events.jsonl</file>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"run_id":"${RUN_ID}"}</customFields>
      <fieldNames>
        <timestamp>ts</timestamp>
        <version>@version</version>
        <message>message</message>
        <logger>logger</logger>
        <thread>thread</thread>
        <level>level</level>
        <levelValue>level_value</levelValue>
        <mdc>mdc</mdc>
      </fieldNames>
      <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS</timestampPattern>
      <includeMdcKeyName>true</includeMdcKeyName>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${LOG_FILE}/events.%i.jsonl</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>10</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>50MB</maxFileSize>
    </triggeringPolicy>
  </appender>

  <!-- File appender for human-readable logs -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}/run.log</file>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${LOG_FILE}/run.%i.log</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>10</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>10MB</maxFileSize>
    </triggeringPolicy>
  </appender>

  <!-- Async appender for JSON events -->
  <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>512</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <appender-ref ref="JSON_FILE"/>
  </appender>

  <!-- Async appender for human-readable logs -->
  <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>512</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <appender-ref ref="FILE"/>
  </appender>

  <!-- Logger for experiment events (optimization iterations, convergence) -->
  <logger name="za.ac.uj.racinglines.log.Events" level="DEBUG" additivity="false">
    <appender-ref ref="ASYNC_JSON"/>
    <appender-ref ref="CONSOLE"/>
  </logger>

  <!-- Logger for timed operations (lap time simulation, fitness evaluation) -->
  <logger name="za.ac.uj.racinglines.log.Timed" level="INFO" additivity="false">
    <appender-ref ref="ASYNC_FILE"/>
    <appender-ref ref="CONSOLE"/>
  </logger>

  <!-- Algorithm loggers -->
  <logger name="za.ac.uj.racinglines.pso" level="INFO"/>
  <logger name="za.ac.uj.racinglines.aco" level="INFO"/>
  <logger name="za.ac.uj.racinglines.variant" level="INFO"/>

  <!-- Physics and track loggers -->
  <logger name="za.ac.uj.racinglines.physics" level="INFO"/>
  <logger name="za.ac.uj.racinglines.track" level="INFO"/>

  <!-- Experiment and analysis loggers -->
  <logger name="za.ac.uj.racinglines.experiment" level="INFO"/>
  <logger name="za.ac.uj.racinglines.analysis" level="INFO"/>

  <!-- Root logger: console output + async file output -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="ASYNC_JSON"/>
    <appender-ref ref="ASYNC_FILE"/>
  </root>
</configuration>
